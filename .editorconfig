root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
# Hexagonal layout uses adapter.in / port.in — `in` is a Kotlin keyword, so backticks are required.
ktlint_standard_package-name = disabled
