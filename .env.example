# Copy to `.env` for local overrides (`.env` is gitignored).
# Defaults match local Docker Compose; change these for non-local environments.

POSTGRES_DB=samliothek
POSTGRES_USER=samliothek
POSTGRES_PASSWORD=samliothek

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/samliothek
SPRING_DATASOURCE_USERNAME=samliothek
SPRING_DATASOURCE_PASSWORD=samliothek

SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=samliothek
SPRING_RABBITMQ_PASSWORD=samliothek
